# Copy to .env.test; chmod 600. Never paste secrets into chat.
ENVIRONMENT=test
CRM_MODE=mock
DATABASE_PATH=var/test/bot.sqlite3
CONFIG_PATH=config/mock.json
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=10001
ADMIN_TELEGRAM_IDS=
CRM_BASE_URL=https://itishkino.s20.online
CRM_EMAIL=
CRM_API_KEY=
# Verified local HTTP/SOCKS proxy routing Telegram only; blank = direct.
TELEGRAM_PROXY=
HTTP_TIMEOUT=20
CRM_REQUEST_INTERVAL=0.25
MAX_ATTEMPTS=6
RETRY_BASE=5
RETRY_CAP=1800
INBOX_RETENTION_DAYS=7
BACKUP_PATH=var/test/backups
BACKUP_KEEP=14
