# Рабочий запуск в Docker. Скопируйте в runtime/.env (не в корневой .env).
# Файл и runtime/config.json должны принадлежать UID/GID 10001 и иметь права 600.
ENVIRONMENT=prod
CRM_MODE=real
DATABASE_PATH=/data/prod/bot.sqlite3
CONFIG_PATH=/run/promobot/config.json
BACKUP_PATH=/data/backups

# Токен BotFather. Telegram ID пользователей узнавайте командой /id в боте.
TELEGRAM_BOT_TOKEN=
# Первоначальные администраторы через запятую: владелец, директор, администраторы, IT.
# Остальных каждый администратор может добавлять через меню; они сохраняются в SQLite.
ADMIN_TELEGRAM_IDS=
# Необязательный отдельный ID владельца. Если пусто, используется первый ID из списка выше.
ADMIN_TELEGRAM_ID=

# Технический пользователь AlfaCRM: email и ключ API v2api.
CRM_BASE_URL=https://itishkino.s20.online
CRM_EMAIL=
CRM_API_KEY=

# Пусто = прямое подключение Telegram. CRM работает напрямую.
# Для SOCKS на хосте Docker используйте socks5://host.docker.internal:1080.
TELEGRAM_PROXY=
HTTP_TIMEOUT=20
CRM_REQUEST_INTERVAL=0.25
MAX_ATTEMPTS=6
RETRY_BASE=5
RETRY_CAP=1800
INBOX_RETENTION_DAYS=7
BACKUP_KEEP=14
